      "cost": "cheap",
      "local_cheap": true,
      "quoted_at": "obr/index.html",
      "quote": "0.34× by the twelfth quarter — close to the OBR's published 0.3",
      "basis": "site quote; the 1p basic-rate costing (£6.46bn/yr = £1,615.75m/q) held on household income for an explicit 12-quarter window, so the ratio does not depend on score_reform's default window. Ratio = −ΔGDP(£m) / 1,615.75 (the add-factor carries the revenue raised, so GDP falls). Old pin gave 0.357, new pin 0.342",
      "checks": [
        {
          "name": "gdp_per_revenue_q12",
          "path": [
            "results",
            11,
            "delta_gdp_bn"
          ],
          "scale": -0.6189076280365,
          "expected": 0.34,
          "tolerance": 0.01
        }
      ],
      "quoted_anchor": "<strong>0.34&times;</strong>",
      "via_job": true
    },
