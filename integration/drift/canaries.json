{
  "about": "One cheap call per hosted model whose output the site quotes. drift_check.py calls each on the hosted MCP server and fails when a value leaves its tolerance, when provenance disagrees with the capability registry, or when the hosted source revision is not modal_app.py's pin. Expected values are the site's quoted figures; where a page shows the command but no number, the expected value is a regression pin from the committed pin and says so in 'basis'. Edit an expected value only with the page edit (or the evidence) in the same PR.",
  "canaries": [
    {
      "id": "obr_bank_rate_100bp",
      "model_id": "obr-macro",
      "source_url": "https://github.com/PolicyEngine/obr-macroeconomic-model",
      "tool": "obr_shock",
      "args": {
        "var": "R",
        "shock": 1.0,
        "periods": 12
      },
      "cost": "cheap",
      "local_cheap": true,
      "quoted_at": "obr/index.html",
      "quote": "a sustained +100bp lowers GDP by about £128m on impact, £406m by quarter 4, £475m by quarter 8 and £503m by quarter 12",
      "basis": "site quote; reproduces at OBR pin 0fe04c9 (October 2026 EFO, obr results/site_figures.json, recomputed on Actions run 44378531644), every quarter converged (6fbbe06 on the March 2026 EFO gave -129/-405/-480/-522; e4d7faa gave -121/-431/-482/-416)",
      "checks": [
        {
          "name": "dgdp_q1_m",
          "path": [
            "results",
            0,
            "delta_gdp_bn"
          ],
          "scale": 1000,
          "expected": -128,
          "tolerance": 10
        },
        {
          "name": "dgdp_q4_m",
          "path": [
            "results",
            3,
            "delta_gdp_bn"
          ],
          "scale": 1000,
          "expected": -406,
          "tolerance": 10
        },
        {
          "name": "dgdp_q8_m",
          "path": [
            "results",
            7,
            "delta_gdp_bn"
          ],
          "scale": 1000,
          "expected": -475,
          "tolerance": 10
        },
        {
          "name": "dgdp_q12_m",
          "path": [
            "results",
            11,
            "delta_gdp_bn"
          ],
          "scale": 1000,
          "expected": -503,
          "tolerance": 10
        }
      ],
      "quoted_anchor": "id=\"rate-series\"",
      "via_job": true
    },
    {
      "id": "obr_household_ratio_q12",
      "model_id": "obr-macro",
      "source_url": "https://github.com/PolicyEngine/obr-macroeconomic-model",
