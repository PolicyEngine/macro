{
  "about": "One cheap call per hosted model whose output the site quotes. drift_check.py calls each on the hosted MCP server and fails when a value leaves its tolerance, when provenance disagrees with the capability registry, or when the hosted source revision is not modal_app.py's pin. Expected values are the site's quoted figures; where a page shows the command but no number, the expected value is a regression pin from the committed pin and says so in 'basis'. Edit an expected value only with the page edit (or the evidence) in the same PR.",
  "canaries": [
    {
      "id": "obr_bank_rate_100bp",
      "model_id": "obr-macro",
      "source_url": "https://github.com/PolicyEngine/obr-macroeconomic-model",
      "tool": "obr_shock",
      "args": {
        "var": "R",
        "shock": 1.0,
        "periods": 12
      },
      "cost": "cheap",
      "local_cheap": true,
      "quoted_at": "obr/validation/index.html",
      "quote": "a sustained +100bp lowers GDP by about £121m on impact, £431m by quarter 4, £482m by quarter 8 and £416m by quarter 12",
      "basis": "site quote; reproduces at OBR pin e4d7faa (old pin 1ed742c gave -119/-446/-525/-490)",
      "checks": [
        {
          "name": "dgdp_q1_m",
          "path": [
            "results",
            0,
            "delta_gdp_bn"
          ],
          "scale": 1000,
          "expected": -121,
          "tolerance": 10
        },
        {
          "name": "dgdp_q4_m",
          "path": [
            "results",
            3,
            "delta_gdp_bn"
          ],
          "scale": 1000,
          "expected": -431,
          "tolerance": 10
        },
        {
          "name": "dgdp_q8_m",
          "path": [
            "results",
            7,
            "delta_gdp_bn"
          ],
          "scale": 1000,
          "expected": -482,
          "tolerance": 10
        },
        {
          "name": "dgdp_q12_m",
          "path": [
            "results",
            11,
            "delta_gdp_bn"
          ],
          "scale": 1000,
          "expected": -416,
          "tolerance": 10
        }
      ],
      "quoted_anchor": "£416m by quarter 12",
      "via_job": true
    },
    {
      "id": "obr_household_ratio_q12",
      "model_id": "obr-macro",
      "source_url": "https://github.com/PolicyEngine/obr-macroeconomic-model",
      "tool": "obr_shock",
      "args": {
